# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Pipeline scratch — raw downloads and intermediates are not committed
data/**/raw/
pipeline/_work/
*.tmp
/tmp/
data/generated/*.gpkg

# Per-county source data — everything under data/<county>-county/ that a script
# produces is build output, not committed (see README "Setup" / "Raw per-county
# data" / "One-off scripts"). Only README.md and .gitkeep placeholders (so the
# empty folders still exist) stay tracked.
#   flood-hazard-layers/*.geojson,     <- scripts/import_county_flood_data.py (needs
#   flood-hazard-layers/manifest.json     the sibling Flood Project/ working directory)
#   records/**/*.ndjson                <- scripts/ingest-noaa-*.mjs (public NOAA URLs).
#                                          Hidalgo's storm-events file also carries 16
#                                          hand-curated reports the script can't
#                                          reproduce -- still in git history and on
#                                          disk, just not tracked going forward.
#   manifest.json, sources/**/*.json,  <- scripts/scaffold_county_collections.py
#   schemas/*.schema.json                 (schemas are copied from the tracked
#                                          template at pipeline/schemas/, not
#                                          from any county's own directory)
data/*-county/flood-hazard-layers/*.geojson
data/*-county/flood-hazard-layers/manifest.json
data/*-county/records/**/*.ndjson
data/*-county/manifest.json
data/*-county/schemas/*.schema.json
data/*-county/sources/**/*.json

# Generated overlays — rebuilt by the pipeline scripts, not committed.
#   pipeline/build_layers.py            -> static/data/*.geojson, layers.json
#   pipeline/build_events.py            -> flood-events.geojson, flood-reports.json, rainfall-records.json
src/rgv_flood/static/data/*.geojson
src/rgv_flood/static/data/*.json

# OS / editor
.DS_Store
.idea/
.vscode/
