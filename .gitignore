.ruff_cache/

# The central database and everything else the build produces. Rebuilt by
# pipeline/build_all.py, never committed (see README "Repository Layout").
data/generated/

# The download cache: publishers' own files, kept so a rebuild doesn't fetch
# them again. Safe to delete.
/tmp/

# Inputs for the Hidalgo model: public downloads from pipeline/fetch_ml_inputs.py.
data/ml/

# The only data that IS committed is data/seed/ (see data/seed/README.md).

