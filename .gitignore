# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Pipeline scratch — raw downloads and intermediates are not committed
data/**/raw/
pipeline/_work/
*.tmp
/tmp/
data/generated/*.gpkg
data/generated/*.sqlite3
data/generated/.live-signals-scheduler.lock

# Per-county source data — everything under data/<county>-county/ that
# pipeline/build_all.py can (re)produce on its own is build output, not
# committed (see README "Setup" / "Raw per-county data" / "One-off scripts").
#   records/**/*.ndjson                <- scripts/ingest-noaa-*.mjs (public NOAA URLs)
#   manifest.json, sources/**/*.json,  <- scripts/scaffold_county_collections.py
#   schemas/*.schema.json                 (schemas are copied from the tracked
#                                          template at pipeline/schemas/, not
#                                          from any county's own directory)
#
# Two things build_all.py CANNOT reproduce from a bare clone stay tracked:
#   flood-hazard-layers/*.geojson,manifest.json  -- scripts/import_county_flood_data.py
#     needs the sibling Flood Project/ working directory, which has no public,
#     scripted source (see build_all.py step 5 / README "Raw per-county data").
#   hidalgo-county's events-and-public-reports ndjson -- carries 16 hand-curated
#     reports alongside the NOAA-generated events; the ingest script only
#     preserves them if the file already exists on disk to read back from, so a
#     bare clone has nothing to preserve them from.
data/*-county/records/**/*.ndjson
!data/hidalgo-county/records/events-and-public-reports/noaa-storm-events.ndjson
data/*-county/manifest.json
data/*-county/schemas/*.schema.json
data/*-county/sources/**/*.json

# Generated overlays — rebuilt by the pipeline scripts, not committed.
#   pipeline/build_layers.py            -> static/data/*.geojson, layers.json
#   pipeline/build_events.py            -> flood-events.geojson, flood-reports.json, rainfall-records.json
src/rgv_flood/static/data/*.geojson
src/rgv_flood/static/data/*.json

# OS / editor
.DS_Store
.idea/
.vscode/
