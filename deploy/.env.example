# Copy to deploy/.env on the server and fill in.

# The server's DNS name (the university's, or an Azure *.cloudapp.azure.com name).
RGV_DOMAIN=rgv-flood.example.edu

# The image to run (default: the latest one GitHub Actions published).
# RGV_IMAGE=ghcr.io/luiscarlosgarcia1/senior-proj:2026-10-15

# Live official alerts: refresh every 15 minutes; set false to turn off.
RGV_LIVE_SIGNALS_SCHEDULER_ENABLED=true
RGV_LIVE_SIGNALS_REFRESH_INTERVAL_SECONDS=900

# Basemaps and address search (defaults: OpenFreeMap and Nominatim).
# RGV_BASEMAP_LIGHT_STYLE=https://tiles.openfreemap.org/styles/positron
# RGV_BASEMAP_DARK_STYLE=https://tiles.openfreemap.org/styles/dark
# RGV_GEOCODER_URL=https://nominatim.openstreetmap.org/search

RGV_LOG_LEVEL=INFO
