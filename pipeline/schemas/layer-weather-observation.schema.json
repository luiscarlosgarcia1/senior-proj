{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer-weather-observation.schema.json",
  "title": "Hidalgo County layer or weather-observation record",
  "description": "A source dataset or observation record for static/reference layers or weather. These records are not flood events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "record_kind", "source_reference", "source_publisher", "dataset_name",
    "dataset_version_or_publication_date", "retrieved_at", "coverage_or_station_geometry",
    "original_attributes", "license_or_terms_note"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1, "description": "Stable local identifier." },
    "record_kind": { "type": "string", "enum": ["static_reference_layer", "weather_observation"] },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["landing_page", "api_endpoint", "dataset_identifier"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "source_publisher": { "type": "string", "minLength": 1 },
    "dataset_name": { "type": "string", "minLength": 1 },
    "dataset_version_or_publication_date": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "coverage_or_station_geometry": { "description": "Hidalgo coverage geometry or weather-station geometry; null only when the source cannot provide it.", "anyOf": [{ "type": "null" }, { "type": "object" }] },
    "coverage_or_station_geometry_absence_reason": { "type": "string", "minLength": 1 },
    "original_attributes": { "type": "object", "description": "Original source attributes, units, and quality flags." },
    "license_or_terms_note": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "coverage_or_station_geometry": { "type": "null" } }, "required": ["coverage_or_station_geometry"] },
      "then": { "required": ["coverage_or_station_geometry_absence_reason"] }
    }
  ]
}
