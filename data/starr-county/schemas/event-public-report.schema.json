{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-public-report.schema.json",
  "title": "Hidalgo County event or public-report record",
  "description": "A traceable documented flood event or supplementary public report. Retention is not verification of the claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "source_publisher", "source_channel", "source_reference", "event_start",
    "location_text", "geometry", "location_precision", "record_kind", "summary",
    "original_content_reference", "retrieved_at"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1, "description": "Stable local identifier." },
    "source_publisher": { "type": "string", "minLength": 1, "description": "Publisher or account label, such as NOAA, HCDD1, KRGV, Facebook, Instagram, or X." },
    "source_channel": { "type": "string", "minLength": 1, "description": "Source channel, such as official_dataset, local_news, facebook, instagram, or x." },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["source_url", "source_dataset_id"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "published_at": { "$ref": "#/$defs/flexibleTimestampOrNull", "description": "Source publication time when supplied by the source." },
    "event_start": { "$ref": "#/$defs/flexibleTimestamp", "description": "Required stated event date or time." },
    "event_end": { "$ref": "#/$defs/flexibleTimestampOrNull", "description": "Stated event end when available." },
    "location_text": { "type": "string", "minLength": 1, "description": "Original or normalized Hidalgo County location claim." },
    "geometry": { "$ref": "#/$defs/geometryOrNull" },
    "location_precision": { "type": "string", "enum": ["exact", "address", "street_or_intersection", "named_place", "municipality", "county", "footprint", "unknown"] },
    "geometry_absence_reason": { "type": "string", "minLength": 1, "description": "Required when geometry is null." },
    "record_kind": { "type": "string", "enum": ["flood_event", "public_report"] },
    "summary": { "type": "string", "minLength": 1, "description": "Short factual description without unsupported conclusions." },
    "original_content_reference": { "type": "string", "minLength": 1, "description": "Permitted excerpt, media reference, or archival reference to original content." },
    "duplicate_group_id": { "type": ["string", "null"], "minLength": 1, "description": "Optional link to a likely duplicate occurrence; retain every original source item." },
    "retrieved_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "geometry": { "type": "null" } }, "required": ["geometry"] },
      "then": { "required": ["geometry_absence_reason"] }
    }
  ],
  "$defs": {
    "flexibleTimestamp": { "type": "string", "anyOf": [{ "format": "date" }, { "format": "date-time" }] },
    "flexibleTimestampOrNull": { "anyOf": [{ "$ref": "#/$defs/flexibleTimestamp" }, { "type": "null" }] },
    "geometryOrNull": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "type": "string", "enum": ["Point", "LineString", "Polygon", "MultiPoint", "MultiLineString", "MultiPolygon"] },
            "coordinates": {}
          }
        }
      ]
    }
  }
}
